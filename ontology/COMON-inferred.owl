    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000017"/>
    <obo:IAO_0000115 xml:lang="en">A software entity that implements a specific CMO performance indicator in a concrete programming language or computational framework.</obo:IAO_0000115>
    <rdfs:label>CMO performance indicator implementation</rdfs:label>
