    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <obo:IAO_0000115 xml:lang="en">An individual of the ConstraintStrictness class representing a constraint strictness in which violations may be tolerated or penalized rather than absolutely forbidden.</obo:IAO_0000115>
    <rdfs:label>soft</rdfs:label>
    <owl:sameAs rdf:resource="http://w3id.org/COMON/COMON_000050"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://w3id.org/COMON/COMON_000008">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
