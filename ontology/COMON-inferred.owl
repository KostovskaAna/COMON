    <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <obo:IAO_0000115 xml:lang="en">A problem variable whose possible values are chosen from a set of categories without an inherent numerical ordering.</obo:IAO_0000115>
    <rdfs:label>Categorical problem variable</rdfs:label>
    <owl:sameAs rdf:resource="http://w3id.org/COMON/COMON_000042"/>
    <owl:equivalentClass rdf:resource="http://w3id.org/COMON/COMON_000042"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://w3id.org/COMON/COMON_000003">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000104"/>
    <rdfs:subClassOf rdf:nodeID="N1bfd59b38bf2453c82d743bbced0df91"/>
    <rdfs:subClassOf rdf:resource="http://w3id.org/COMON/COMON_000003"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <obo:IAO_0000115 xml:lang="en">A measure used to quantify some aspect of the performance of a CMO algorithm or of the quality of the solutions it produces when solving constrained multi-objective optimization problems.</obo:IAO_0000115>
    <rdfs:label xml:lang="en">CMO performance indicator</rdfs:label>
    <rdfs:seeAlso xml:lang="en">https://w3id.org/moody#QualityIndicator</rdfs:seeAlso>
    <owl:sameAs rdf:resource="http://w3id.org/COMON/COMON_000003"/>
    <owl:equivalentClass rdf:resource="http://w3id.org/COMON/COMON_000003"/>
  </rdf:Description>
