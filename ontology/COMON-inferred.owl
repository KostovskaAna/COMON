    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000017"/>
    <obo:IAO_0000115 xml:lang="en">A CMO performance indicator implementation that computes an indicator value using the full set of solutions accumulated up to a given point during an algorithm execution (e.g., an archive of all evaluated solutions).</obo:IAO_0000115>
    <rdfs:label>Up-to-point CMO performance indicator implementation</rdfs:label>
    <owl:sameAs rdf:resource="http://w3id.org/COMON/COMON_000009"/>
    <owl:equivalentClass rdf:resource="http://w3id.org/COMON/COMON_000009"/>
  </rdf:Description>
