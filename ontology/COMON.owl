                <owl:someValuesFrom rdf:resource="http://w3id.org/COMON/COMON_000004"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A concrete run of a CMO algorithm implementation on a given CMO problem implementation under specified parameter settings and computational conditions.</obo:IAO_0000115>
        <rdfs:label>CMO algorithm execution</rdfs:label>
    </owl:Class>
    


    <!-- http://w3id.org/COMON/COMON_000007 -->

    <owl:Class rdf:about="http://w3id.org/COMON/COMON_000007">
        <rdfs:subClassOf rdf:resource="http://www.ebi.ac.uk/efo/swo/SWO_0000393"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/OBI_0000299"/>
