            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A software or workflow entity that specifies and operationalizes how a CMO experiment is to be executed.</obo:IAO_0000115>
        <rdfs:label>CMO experiment implementation</rdfs:label>
    </owl:Class>
    


    <!-- http://w3id.org/COMON/COMON_000016 -->

    <owl:Class rdf:about="http://w3id.org/COMON/COMON_000016">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000030"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://w3id.org/COMON/COMON_000026"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/COMON/COMON_000044"/>
                <owl:someValuesFrom rdf:resource="http://w3id.org/COMON/COMON_000043"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A problem in which one seeks values for decision variables that optimize one or more objective functions, possibly subject to constraints.</obo:IAO_0000115>
        <rdfs:label>Optimization problem</rdfs:label>
    </owl:Class>
    


    <!-- http://w3id.org/COMON/COMON_000017 -->

    <owl:Class rdf:about="http://w3id.org/COMON/COMON_000017">
        <rdfs:subClassOf rdf:resource="http://w3id.org/COMON/COMON_000016"/>
        <obo:IAO_0000115 xml:lang="en">An optimization problem that involves two or more objective functions to be optimized simultaneously.</obo:IAO_0000115>
        <rdfs:label>Multi-objective optimization problem</rdfs:label>
    </owl:Class>
    


    <!-- http://w3id.org/COMON/COMON_000018 -->

    <owl:Class rdf:about="http://w3id.org/COMON/COMON_000018">
        <rdfs:subClassOf rdf:resource="http://w3id.org/COMON/COMON_000017"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://w3id.org/COMON/COMON_000027"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000058"/>
                <owl:someValuesFrom rdf:resource="http://w3id.org/COMON/COMON_000077"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/COMON/COMON_000052"/>
                <owl:someValuesFrom rdf:resource="http://w3id.org/COMON/COMON_000053"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A multi-objective optimization problem that includes one or more constraints restricting the feasible decision space.</obo:IAO_0000115>
        <rdfs:label>CMO problem</rdfs:label>
        <rdfs:seeAlso xml:lang="en">https://w3id.org/BIGOWLProblems/Problem</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://w3id.org/COMON/COMON_000019 -->

    <owl:Class rdf:about="http://w3id.org/COMON/COMON_000019">
        <rdfs:subClassOf rdf:resource="http://w3id.org/COMON/COMON_000022"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/OBI_0000293"/>
                <owl:someValuesFrom rdf:resource="http://w3id.org/COMON/COMON_000075"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A CMO performance indicator that measures solution quality over three separate states: infeasible, feasible but within a region of interest, and feasible within the region of interest.</obo:IAO_0000115>
        <rdfs:label>ICMOP</rdfs:label>
    </owl:Class>
    


    <!-- http://w3id.org/COMON/COMON_000020 -->

    <owl:Class rdf:about="http://w3id.org/COMON/COMON_000020">
        <rdfs:subClassOf rdf:resource="http://w3id.org/COMON/COMON_000024"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/OBI_0000293"/>
                <owl:someValuesFrom rdf:resource="http://w3id.org/COMON/COMON_000075"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A CMO performance indicator that measures the size of the objective-space region dominated by a solution set and bounded by a reference point.</obo:IAO_0000115>
        <rdfs:label>Hypervolume</rdfs:label>
    </owl:Class>
    


    <!-- http://w3id.org/COMON/COMON_000021 -->

    <owl:Class rdf:about="http://w3id.org/COMON/COMON_000021">
        <rdfs:subClassOf rdf:resource="http://w3id.org/COMON/COMON_000024"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/OBI_0000293"/>
                <owl:someValuesFrom rdf:resource="http://w3id.org/COMON/COMON_000074"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A CMO performance indicator that measures the average distance from points in a reference set to the nearest solution in an approximation set using the IGD+ distance formulation.</obo:IAO_0000115>
        <rdfs:label>IGD+</rdfs:label>
    </owl:Class>
    


    <!-- http://w3id.org/COMON/COMON_000022 -->

    <owl:Class rdf:about="http://w3id.org/COMON/COMON_000022">
        <rdfs:subClassOf rdf:resource="http://w3id.org/COMON/COMON_000003"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/OBI_0000293"/>
                <owl:someValuesFrom rdf:resource="http://w3id.org/COMON/COMON_000076"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A CMO performance indicator that captures both objective-space quality and constraint-related aspects of a solution set or algorithm outcome.</obo:IAO_0000115>
        <rdfs:label>Mixed CMO performance indicator</rdfs:label>
    </owl:Class>
    


    <!-- http://w3id.org/COMON/COMON_000023 -->

    <owl:Class rdf:about="http://w3id.org/COMON/COMON_000023">
        <rdfs:subClassOf rdf:resource="http://w3id.org/COMON/COMON_000025"/>
        <obo:IAO_0000115 xml:lang="en">A measure of the overall amount by which a solution violates the constraints of a constrained optimization problem.</obo:IAO_0000115>
        <rdfs:label>Total constraint violation</rdfs:label>
    </owl:Class>
    


    <!-- http://w3id.org/COMON/COMON_000024 -->

    <owl:Class rdf:about="http://w3id.org/COMON/COMON_000024">
        <rdfs:subClassOf rdf:resource="http://w3id.org/COMON/COMON_000003"/>
        <obo:IAO_0000115 xml:lang="en">A CMO performance indicator specification that defines how the performance indicator is to be computed for a particular optimization objective.</obo:IAO_0000115>
        <rdfs:label>Objective-specific CMO performance indicator specification</rdfs:label>
    </owl:Class>
    


    <!-- http://w3id.org/COMON/COMON_000025 -->

    <owl:Class rdf:about="http://w3id.org/COMON/COMON_000025">
        <rdfs:subClassOf rdf:resource="http://w3id.org/COMON/COMON_000003"/>
        <obo:IAO_0000115 xml:lang="en">A CMO performance indicator specification that defines how the performance indicator is to be computed for a particular optimization constraint.</obo:IAO_0000115>
        <rdfs:label>Constraint-specific CMO performance indicator specification</rdfs:label>
    </owl:Class>
    


    <!-- http://w3id.org/COMON/COMON_000026 -->

    <owl:Class rdf:about="http://w3id.org/COMON/COMON_000026">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000030"/>
        <rdfs:subClassOf>
