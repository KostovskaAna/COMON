    </rdf:Description>
    


    <!-- http://purl.org/dc/terms/BibliographicResource -->

    <owl:Class rdf:about="http://purl.org/dc/terms/BibliographicResource"/>
    


    <!-- http://w3id.org/COMON/COMON_000001 -->

    <owl:Class rdf:about="http://w3id.org/COMON/COMON_000001">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000064"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/OBI_0000297"/>
                <owl:someValuesFrom rdf:resource="http://w3id.org/COMON/COMON_000004"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/COMON/COMON_000066"/>
                <owl:someValuesFrom rdf:resource="http://w3id.org/COMON/COMON_000065"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/COMON/COMON_000067"/>
                <owl:someValuesFrom rdf:resource="http://w3id.org/COMON/COMON_000001"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">An algorithm that is designed to solve constrained multi-objective optimization (CMO) problems by simultaneously optimizing two or more conflicting objective functions subject to one or more constraints, producing a set of feasible trade-off solutions that approximate the constrained Pareto front.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">CMO algorithm</rdfs:label>
        <rdfs:seeAlso xml:lang="en">https://w3id.org/BIGOWLAlgorithms/Algorithm</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://w3id.org/COMON/COMON_000002 -->

    <owl:Class rdf:about="http://w3id.org/COMON/COMON_000002">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000104"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://w3id.org/COMON/COMON_000003"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/OBI_0000297"/>
                <owl:someValuesFrom rdf:resource="http://w3id.org/COMON/COMON_000015"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A planned study in which a CMO algorithm is applied to a multi-objective optimization problem under specified conditions in order to assess, compare, or analyze their behavior and performance.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">CMO experiment</rdfs:label>
        <rdfs:seeAlso xml:lang="en">https://w3id.org/moody#Experiment</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://w3id.org/COMON/COMON_000003 -->

    <owl:Class rdf:about="http://w3id.org/COMON/COMON_000003">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000104"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/OBI_0000297"/>
                <owl:someValuesFrom rdf:resource="http://w3id.org/COMON/COMON_000008"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A measure used to quantify some aspect of the performance of a CMO algorithm or of the quality of the solutions it produces when solving constrained multi-objective optimization problems.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">CMO performance indicator</rdfs:label>
        <rdfs:seeAlso xml:lang="en">https://w3id.org/moody#QualityIndicator</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://w3id.org/COMON/COMON_000004 -->

    <owl:Class rdf:about="http://w3id.org/COMON/COMON_000004">
        <rdfs:subClassOf rdf:resource="http://www.ontodm.com/OntoDM-core/OntoDM_112569"/>
        <rdfs:subClassOf>
            <owl:Restriction>
