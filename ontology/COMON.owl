    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/IAO_0000064 -->

    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/IAO_0000064">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/OBI_0000297"/>
