    <!-- http://purl.obofoundry.org/obo/OBI_0000260 -->

    <owl:Class rdf:about="http://purl.obofoundry.org/obo/OBI_0000260">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000017"/>
