                <owl:someValuesFrom rdf:resource="http://w3id.org/COMON/COMON_000006"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A software entity that implements a specific CMO algorithm in a concrete programming language or computational framework.</obo:IAO_0000115>
        <rdfs:label>CMO algorithm implementation</rdfs:label>
    </owl:Class>
    


    <!-- http://w3id.org/COMON/COMON_000006 -->

    <owl:Class rdf:about="http://w3id.org/COMON/COMON_000006">
