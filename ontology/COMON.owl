        <rdfs:subClassOf rdf:resource="http://w3id.org/COMON/COMON_000039"/>
        <obo:IAO_0000115 xml:lang="en">A problem variable that can take values from a continuous domain.</obo:IAO_0000115>
        <rdfs:label>Continuous problem variable</rdfs:label>
    </owl:Class>
    


    <!-- http://w3id.org/COMON/COMON_000041 -->

