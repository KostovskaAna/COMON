            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A data item representing the value produced by a CMO performance indicator execution.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">CMO performance indicator datum</rdfs:label>
        <rdfs:seeAlso xml:lang="en">https://w3id.org/moody#QualityIndicatorValue</rdfs:seeAlso>
    </owl:Class>
    


