     -->

    


    <!-- http://w3id.org/COMON/COMON_000028 -->

    <owl:DatatypeProperty rdf:about="http://w3id.org/COMON/COMON_000028">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
        <obo:IAO_0000115 xml:lang="en">A data property that specifies the minimum value used to normalize an objective or  constraint.</obo:IAO_0000115>
        <rdfs:label>normalization_min</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://w3id.org/COMON/COMON_000029 -->

    <owl:DatatypeProperty rdf:about="http://w3id.org/COMON/COMON_000029">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
        <obo:IAO_0000115 xml:lang="en">A data property that specifies the maximum value used to normalize an objective or  constraint.</obo:IAO_0000115>
        <rdfs:label>normalization_max</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://w3id.org/COMON/COMON_000030 -->

    <owl:DatatypeProperty rdf:about="http://w3id.org/COMON/COMON_000030">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
        <obo:IAO_0000115 xml:lang="en">A data property that specifies the relative importance assigned to an objective or  constraint.</obo:IAO_0000115>
        <rdfs:label>weight</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://w3id.org/COMON/COMON_000032 -->

    <owl:DatatypeProperty rdf:about="http://w3id.org/COMON/COMON_000032">
        <obo:IAO_0000115 xml:lang="en">A data property that indicates whether gradient information is available for an optimization problem.</obo:IAO_0000115>
        <rdfs:label>gradientAvailability</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://w3id.org/COMON/COMON_000033 -->

    <owl:DatatypeProperty rdf:about="http://w3id.org/COMON/COMON_000033">
        <obo:IAO_0000115 xml:lang="en">A data property that specifies how many fidelity levels are available in a multi-fidelity optimization problem.</obo:IAO_0000115>
        <rdfs:label>numberOfFidelityLevels</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://w3id.org/COMON/COMON_000034 -->

    <owl:DatatypeProperty rdf:about="http://w3id.org/COMON/COMON_000034">
        <obo:IAO_0000115 xml:lang="en">A data property that indicates whether an optimization problem is affected by stochastic noise.</obo:IAO_0000115>
        <rdfs:label>noise</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://w3id.org/COMON/COMON_000035 -->

    <owl:DatatypeProperty rdf:about="http://w3id.org/COMON/COMON_000035">
        <obo:IAO_0000115 xml:lang="en">A data property that specifies an approximation of the Pareto front associated with a problem or solution set.</obo:IAO_0000115>
        <rdfs:label>paretoFrontApproximation</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://w3id.org/COMON/COMON_000036 -->

    <owl:DatatypeProperty rdf:about="http://w3id.org/COMON/COMON_000036">
        <obo:IAO_0000115 xml:lang="en">A data property that specifies an approximation of the Pareto set associated with a problem or solution set.</obo:IAO_0000115>
        <rdfs:label>paretoSetApproximation</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://w3id.org/COMON/COMON_000037 -->

    <owl:DatatypeProperty rdf:about="http://w3id.org/COMON/COMON_000037">
        <obo:IAO_0000115 xml:lang="en">A data property that specifies the nadir point, namely the vector of worst objective values among the Pareto-optimal solutions under consideration.</obo:IAO_0000115>
        <rdfs:label>nadir</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://w3id.org/COMON/COMON_000038 -->

    <owl:DatatypeProperty rdf:about="http://w3id.org/COMON/COMON_000038">
        <obo:IAO_0000115 xml:lang="en">A data property that specifies the ideal point, namely the vector of best objective values attainable for each objective under consideration.</obo:IAO_0000115>
        <rdfs:label>ideal</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://w3id.org/COMON/COMON_000069 -->

    <owl:DatatypeProperty rdf:about="http://w3id.org/COMON/COMON_000069">
        <rdfs:domain rdf:resource="http://w3id.org/COMON/COMON_000014"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <obo:IAO_0000115 xml:lang="en">A data property that specifies the maximum number of solution evaluations allowed during an experiment execution.</obo:IAO_0000115>
        <rdfs:label>maxNumberOfSolutionEvaluations</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://w3id.org/COMON/COMON_000070 -->

    <owl:DatatypeProperty rdf:about="http://w3id.org/COMON/COMON_000070">
        <rdfs:domain rdf:resource="http://w3id.org/COMON/COMON_000014"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#duration"/>
        <obo:IAO_0000115 xml:lang="en">A data property that specifies the maximum execution time allowed for a single run of an experiment.</obo:IAO_0000115>
        <rdfs:label>maxTimePerRun</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://w3id.org/COMON/COMON_000071 -->

    <owl:DatatypeProperty rdf:about="http://w3id.org/COMON/COMON_000071">
        <rdfs:domain rdf:resource="http://w3id.org/COMON/COMON_000014"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <obo:IAO_0000115 xml:lang="en">A data property that specifies the model or convention used to quantify computational cost in an experiment execution.</obo:IAO_0000115>
        <rdfs:label>costModel</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://w3id.org/COMON/COMON_000072 -->

    <owl:DatatypeProperty rdf:about="http://w3id.org/COMON/COMON_000072">
        <rdfs:domain rdf:resource="http://w3id.org/COMON/COMON_000014"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <obo:IAO_0000115 xml:lang="en">A data property that specifies the condition or set of conditions under which an algorithm execution is terminated.</obo:IAO_0000115>
        <rdfs:label>stoppingCriteria</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://w3id.org/COMON/COMON_000073 -->

    <owl:DatatypeProperty rdf:about="http://w3id.org/COMON/COMON_000073">
        <rdfs:domain rdf:resource="http://w3id.org/COMON/COMON_000014"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <obo:IAO_0000115 xml:lang="en">A data property that specifies the parameter values used for the particular algorithm specified in the experiment.</obo:IAO_0000115>
        <rdfs:label>algorithmParameterSettings</rdfs:label>
    </owl:DatatypeProperty>
    


