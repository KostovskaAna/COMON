<?xml version="1.0"?>
<rdf:RDF xmlns="https://w3id.org/moody#"
     xml:base="https://w3id.org/moody"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:swrl="http://www.w3.org/2003/11/swrl#"
     xmlns:swrla="http://swrl.stanford.edu/ontologies/3.3/swrla.owl#"
     xmlns:swrlb="http://www.w3.org/2003/11/swrlb#"
     xmlns:optimization-anotation="https://w3id.org/moody#">
    <owl:Ontology rdf:about="https://w3id.org/moody"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- https://w3id.org/moody#externalArchiveValue -->

    <owl:AnnotationProperty rdf:about="https://w3id.org/moody#externalArchiveValue"/>
    


    <!-- http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled -->

    <owl:AnnotationProperty rdf:about="http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- https://w3id.org/moody#algorithmUsed -->

    <owl:ObjectProperty rdf:about="https://w3id.org/moody#algorithmUsed">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/moody#Experiment"/>
        <rdfs:range rdf:resource="http://www.khaos.uma.es/perception/bigowl#Algorithm"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/moody#compatibleWith -->

    <owl:ObjectProperty rdf:about="https://w3id.org/moody#compatibleWith">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="http://www.e-lico.eu/ontologies/dmo/DMOP/DMOP.owl#Parameter"/>
        <rdfs:range rdf:resource="http://www.khaos.uma.es/perception/bigowl#Algorithm"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/moody#evaluatedBy -->

    <owl:ObjectProperty rdf:about="https://w3id.org/moody#evaluatedBy">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/moody#Experiment"/>
        <rdfs:range rdf:resource="https://w3id.org/moody#QualityIndicator"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/moody#indicatorValue -->

    <owl:ObjectProperty rdf:about="https://w3id.org/moody#indicatorValue">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/moody#ProblemResolution"/>
        <rdfs:range rdf:resource="https://w3id.org/moody#QualityIndicatorValue"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/moody#parameterValue -->

    <owl:ObjectProperty rdf:about="https://w3id.org/moody#parameterValue">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/moody#Experiment"/>
        <rdfs:range rdf:resource="https://w3id.org/moody#ParameterValue"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/moody#partOfExperiment -->

    <owl:ObjectProperty rdf:about="https://w3id.org/moody#partOfExperiment">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/moody#ProblemResolution"/>
        <rdfs:range rdf:resource="https://w3id.org/moody#Experiment"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/moody#problemSolved -->

    <owl:ObjectProperty rdf:about="https://w3id.org/moody#problemSolved">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/moody#Experiment"/>
        <rdfs:range rdf:resource="http://www.khaos.uma.es/lod/bigowl#Problem"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/moody#using -->

    <owl:ObjectProperty rdf:about="https://w3id.org/moody#using">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/moody#Experiment"/>
        <rdfs:range rdf:resource="http://www.e-lico.eu/ontologies/dmo/DMOP/DMOP.owl#Parameter"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/moody#valueOfIndicator -->

    <owl:ObjectProperty rdf:about="https://w3id.org/moody#valueOfIndicator">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/moody#QualityIndicatorValue"/>
        <rdfs:range rdf:resource="https://w3id.org/moody#QualityIndicator"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/moody#valueOfParameter -->

    <owl:ObjectProperty rdf:about="https://w3id.org/moody#valueOfParameter">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/moody#ParameterValue"/>
        <rdfs:range rdf:resource="http://www.e-lico.eu/ontologies/dmo/DMOP/DMOP.owl#Parameter"/>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- https://w3id.org/moody#aggregativeFunctionValue -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/moody#aggregativeFunctionValue">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/moody#parameterValueProperty"/>
        <rdfs:range>
            <rdfs:Datatype>
                <owl:oneOf>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                        <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PenaltyBoundaryIntersection</rdf:first>
                        <rdf:rest>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Tschebycheff</rdf:first>
                                <rdf:rest>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                        <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">WeightedSum</rdf:first>
                                        <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                    </rdf:Description>
                                </rdf:rest>
                            </rdf:Description>
                        </rdf:rest>
                    </rdf:Description>
                </owl:oneOf>
            </rdfs:Datatype>
        </rdfs:range>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/moody#algorithmResultValue -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/moody#algorithmResultValue">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/moody#parameterValueProperty"/>
        <rdfs:range>
            <rdfs:Datatype>
                <owl:oneOf>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                        <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">externalArchive</rdf:first>
                        <rdf:rest>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">population</rdf:first>
                                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                            </rdf:Description>
                        </rdf:rest>
                    </rdf:Description>
                </owl:oneOf>
            </rdfs:Datatype>
        </rdfs:range>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/moody#averageProportionOfDominatedNeighbours -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/moody#averageProportionOfDominatedNeighbours">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/moody#problemProperty"/>
        <rdfs:isDefinedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Arnaud Liefooghe, Sébastien Verel, Benjamin Lacroix, Alexandru-Ciprian Zăvoianu, and John McCall. 2021. Landscape features and automated algorithm selection for multi-objective interpolated continuous optimisation problems. Proceedings of the Genetic and Evolutionary Computation Conference. Association for Computing Machinery, New York, NY, USA, 421–429. DOI: https://doi.org/10.1145/3449639.3459353</rdfs:isDefinedBy>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/moody#averageProportionOfDominatingNeighbours -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/moody#averageProportionOfDominatingNeighbours">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/moody#problemProperty"/>
        <rdfs:isDefinedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Arnaud Liefooghe, Sébastien Verel, Benjamin Lacroix, Alexandru-Ciprian Zăvoianu, and John McCall. 2021. Landscape features and automated algorithm selection for multi-objective interpolated continuous optimisation problems. Proceedings of the Genetic and Evolutionary Computation Conference. Association for Computing Machinery, New York, NY, USA, 421–429. DOI: https://doi.org/10.1145/3449639.3459353</rdfs:isDefinedBy>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/moody#averageProportionOfIncomparableNeighbours -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/moody#averageProportionOfIncomparableNeighbours">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/moody#problemProperty"/>
        <rdfs:isDefinedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Arnaud Liefooghe, Sébastien Verel, Benjamin Lacroix, Alexandru-Ciprian Zăvoianu, and John McCall. 2021. Landscape features and automated algorithm selection for multi-objective interpolated continuous optimisation problems. Proceedings of the Genetic and Evolutionary Computation Conference. Association for Computing Machinery, New York, NY, USA, 421–429. DOI: https://doi.org/10.1145/3449639.3459353</rdfs:isDefinedBy>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/moody#averageProportionOfLocallyNonDominatedNeighbours -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/moody#averageProportionOfLocallyNonDominatedNeighbours">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/moody#problemProperty"/>
        <rdfs:isDefinedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Arnaud Liefooghe, Sébastien Verel, Benjamin Lacroix, Alexandru-Ciprian Zăvoianu, and John McCall. 2021. Landscape features and automated algorithm selection for multi-objective interpolated continuous optimisation problems. Proceedings of the Genetic and Evolutionary Computation Conference. Association for Computing Machinery, New York, NY, USA, 421–429. DOI: https://doi.org/10.1145/3449639.3459353</rdfs:isDefinedBy>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/moody#averageProportionOfSuportedLocallyNonDominatedNeighbours -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/moody#averageProportionOfSuportedLocallyNonDominatedNeighbours">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/moody#problemProperty"/>
        <rdfs:isDefinedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Arnaud Liefooghe, Sébastien Verel, Benjamin Lacroix, Alexandru-Ciprian Zăvoianu, and John McCall. 2021. Landscape features and automated algorithm selection for multi-objective interpolated continuous optimisation problems. Proceedings of the Genetic and Evolutionary Computation Conference. Association for Computing Machinery, New York, NY, USA, 421–429. DOI: https://doi.org/10.1145/3449639.3459353</rdfs:isDefinedBy>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/moody#bias -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/moody#bias">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/moody#problemProperty"/>
        <rdfs:range>
            <rdfs:Datatype>
                <owl:oneOf>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                        <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">flat</rdf:first>
                        <rdf:rest>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">parameter dependent</rdf:first>
                                <rdf:rest>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                        <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">polynomial</rdf:first>
                                        <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                    </rdf:Description>
                                </rdf:rest>
                            </rdf:Description>
                        </rdf:rest>
                    </rdf:Description>
                </owl:oneOf>
            </rdfs:Datatype>
        </rdfs:range>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/moody#blxAlphaCrossoverAlphaValueValue -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/moody#blxAlphaCrossoverAlphaValueValue">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/moody#parameterValueProperty"/>
        <rdfs:range>
            <rdfs:Datatype>
                <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
                <owl:withRestrictions rdf:parseType="Collection">
                    <rdf:Description>
                        <xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.0</xsd:minInclusive>
                    </rdf:Description>
                    <rdf:Description>
                        <xsd:maxInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1.0</xsd:maxInclusive>
                    </rdf:Description>
                </owl:withRestrictions>
            </rdfs:Datatype>
        </rdfs:range>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/moody#createInitialSolutionsValue -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/moody#createInitialSolutionsValue">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/moody#parameterValueProperty"/>
        <rdfs:range>
            <rdfs:Datatype>
                <owl:oneOf>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                        <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">latinHypercubeSampling</rdf:first>
                        <rdf:rest>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">random</rdf:first>
                                <rdf:rest>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                        <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">scatterSearch</rdf:first>
                                        <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                    </rdf:Description>
                                </rdf:rest>
                            </rdf:Description>
                        </rdf:rest>
                    </rdf:Description>
                </owl:oneOf>
            </rdfs:Datatype>
        </rdfs:range>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/moody#crossoverProbabilityValue -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/moody#crossoverProbabilityValue">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/moody#parameterValueProperty"/>
        <rdfs:range>
            <rdfs:Datatype>
                <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
                <owl:withRestrictions rdf:parseType="Collection">
                    <rdf:Description>
                        <xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#double">0.0</xsd:minInclusive>
                    </rdf:Description>
                    <rdf:Description>
                        <xsd:maxInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#double">1.0</xsd:maxInclusive>
                    </rdf:Description>
                </owl:withRestrictions>
            </rdfs:Datatype>
        </rdfs:range>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/moody#crossoverRepairStrategyValue -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/moody#crossoverRepairStrategyValue">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/moody#parameterValueProperty"/>
        <rdfs:range>
            <rdfs:Datatype>
                <owl:oneOf>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                        <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">bounds</rdf:first>
                        <rdf:rest>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">random</rdf:first>
                                <rdf:rest>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                        <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">round</rdf:first>
                                        <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                    </rdf:Description>
                                </rdf:rest>
                            </rdf:Description>
                        </rdf:rest>
                    </rdf:Description>
                </owl:oneOf>
            </rdfs:Datatype>
        </rdfs:range>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/moody#crossoverValue -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/moody#crossoverValue">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/moody#parameterValueProperty"/>
        <rdfs:range>
            <rdfs:Datatype>
                <owl:oneOf>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                        <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">BLX_ALPHA</rdf:first>
                        <rdf:rest>
                            <rdf:Description>
                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SBX</rdf:first>
                                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                            </rdf:Description>
                        </rdf:rest>
                    </rdf:Description>
                </owl:oneOf>
            </rdfs:Datatype>
        </rdfs:range>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/moody#currentNumberOfEvaluations -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/moody#currentNumberOfEvaluations">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/moody#ProblemResolution"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/moody#distanceFAverage -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/moody#distanceFAverage">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/moody#problemProperty"/>
        <rdfs:isDefinedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Arnaud Liefooghe, Sébastien Verel, Benjamin Lacroix, Alexandru-Ciprian Zăvoianu, and John McCall. 2021. Landscape features and automated algorithm selection for multi-objective interpolated continuous optimisation problems. Proceedings of the Genetic and Evolutionary Computation Conference. Association for Computing Machinery, New York, NY, USA, 421–429. DOI: https://doi.org/10.1145/3449639.3459353</rdfs:isDefinedBy>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/moody#distanceFMaximum -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/moody#distanceFMaximum">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/moody#problemProperty"/>
        <rdfs:isDefinedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Arnaud Liefooghe, Sébastien Verel, Benjamin Lacroix, Alexandru-Ciprian Zăvoianu, and John McCall. 2021. Landscape features and automated algorithm selection for multi-objective interpolated continuous optimisation problems. Proceedings of the Genetic and Evolutionary Computation Conference. Association for Computing Machinery, New York, NY, USA, 421–429. DOI: https://doi.org/10.1145/3449639.3459353</rdfs:isDefinedBy>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/moody#distanceXAverage -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/moody#distanceXAverage">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/moody#problemProperty"/>
        <rdfs:isDefinedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Arnaud Liefooghe, Sébastien Verel, Benjamin Lacroix, Alexandru-Ciprian Zăvoianu, and John McCall. 2021. Landscape features and automated algorithm selection for multi-objective interpolated continuous optimisation problems. Proceedings of the Genetic and Evolutionary Computation Conference. Association for Computing Machinery, New York, NY, USA, 421–429. DOI: https://doi.org/10.1145/3449639.3459353</rdfs:isDefinedBy>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/moody#distanceXMaximum -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/moody#distanceXMaximum">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/moody#problemProperty"/>
        <rdfs:isDefinedBy rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Arnaud Liefooghe, Sébastien Verel, Benjamin Lacroix, Alexandru-Ciprian Zăvoianu, and John McCall. 2021. Landscape features and automated algorithm selection for multi-objective interpolated continuous optimisation problems. Proceedings of the Genetic and Evolutionary Computation Conference. Association for Computing Machinery, New York, NY, USA, 421–429. DOI: https://doi.org/10.1145/3449639.3459353</rdfs:isDefinedBy>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/moody#distanceXMaximumAnalytically -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/moody#distanceXMaximumAnalytically">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/moody#problemProperty"/>
    </owl:DatatypeProperty>
    


